# Copy to .env.local (gitignored) to override. Not required — defaults to "en".
# Only affects the language shown to a visitor who has never picked one yet;
# a returning visitor's own EN/VI choice (stored in their browser) always wins.
VITE_DEFAULT_LANGUAGE=en

# Required. From your Supabase project: Settings -> API.
# The anon key is meant to be public (it ships in the client bundle) — access
# control is via the RLS policies in supabase/schema.sql, not by keeping this
# secret. Never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave EMPTY in production: the Relief Map calls this deployment's own serverless
# functions (3goods/api/*) at same-origin /api/provinces|facilities|metro-hubs|item-needs|meta
# (see src/features/map/api/mapApiClient.js). Set an absolute URL only to point the map at a
# different API, e.g. https://3goods.vercel.app while running `npm run dev` (Vite does not serve
# /api locally, so without it the map uses the bundled snapshot in public/data/ and says so).
# Trailing slash optional. (The former separate map-API deployment, 002-data-4-life, no longer exists.)
# If the API can't be reached, the bundled snapshot in public/data/ is used and the map says so.
VITE_MAP_API_BASE_URL=
